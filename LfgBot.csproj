<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>lfgbot-discord</UserSecretsId>
    <!-- Небольшой VPS: обычный (workstation) сборщик мусора без фонового потока — меньше памяти, паузы незаметны для бота -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Без ICU (данные локалей ~30 МБ в памяти): все тексты бота свои, даты/числа форматируются явно; libicu на сервере не нужна -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Сборщик мусора бережёт память: чаще уплотняет кучу вместо того, чтобы занимать новую (слабый VPS) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <!-- Отдавать неиспользуемую память системе, а не держать её про запас -->
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Веб-админка (ASP.NET Core) в том же процессе, что и бот -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Файлы веб-админки вшиты в exe — отдельно копировать на сервер не нужно -->
    <EmbeddedResource Include="Web/wwwroot/**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- Работа как служба systemd на Linux (на Windows ничего не меняет) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>

</Project>
